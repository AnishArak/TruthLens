# ---------- Backend ----------
FLASK_ENV=development
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5173

# ---------- MongoDB ----------
# Leave running locally on the default port, or paste an Atlas connection string.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=truthlens

# ---------- Evidence retrieval (optional) ----------
# Supported providers: none | newsapi | serpapi
# With "none", evidence retrieval is reported as UNAVAILABLE (nothing is invented).
SEARCH_PROVIDER=none
NEWSAPI_KEY=
SERPAPI_KEY=

# ---------- Semantic similarity (optional) ----------
# Set to true to download/use a Sentence-Transformers model for evidence relevance.
# If false (or the package is missing) a TF-IDF cosine fallback is used and labelled as such.
USE_SENTENCE_TRANSFORMERS=false
SENTENCE_MODEL=all-MiniLM-L6-v2

# ---------- URL extraction limits ----------
URL_FETCH_TIMEOUT=8
URL_MAX_BYTES=2000000
